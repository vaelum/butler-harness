"""Project-specific butler tasks for %%NAME%%.

Anything butler.toml can't express goes here and still shows up under
`python butler.py --help` alongside the built-in commands.

Handlers are introspected by parameter name: `ctx` is always first, add `args`
for the parsed flags, and `inner` (wrapping tasks only) for the built-in you
replaced.
"""

from butler import arg, task, ui


@task("hello", help="a starting point — delete me")
def hello(ctx):
    ui.ok("hello from", f"{ctx.name} at {ctx.root}")


